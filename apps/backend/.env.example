# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lexmind_ai?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-generate-with-openssl-rand-base64-32
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# For S3 compatible storage
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=lexmind-ai
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# AI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password-here
EMAIL_FROM="LexMind AI <your-email@gmail.com>"
FRONTEND_URL=http://localhost:3000
